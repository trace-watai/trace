{
  "$defs": {
    "AgentConfig": {
      "additionalProperties": true,
      "description": "Provider-agnostic description of the agent under test.\n\nMODEL-AGNOSTIC (team mandate): ``provider`` is a free string. Never couple\nthis schema to a vendor SDK \u2014 the runner maps the string to an adapter.",
      "properties": {
        "agent_framework": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "e.g. 'langgraph' | 'react' | 'simple'.",
          "title": "Agent Framework"
        },
        "max_steps": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Step budget for the run, if enforced.",
          "title": "Max Steps"
        },
        "model": {
          "description": "Model identifier as the provider names it.",
          "title": "Model",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "description": "Sampling/config params (temperature, max_tokens, ...).",
          "title": "Params",
          "type": "object"
        },
        "provider": {
          "description": "LLM provider id, e.g. 'gemini' | 'openai' | 'anthropic' | 'local'. No SDK coupling.",
          "title": "Provider",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model"
      ],
      "title": "AgentConfig",
      "type": "object"
    },
    "AttributionEvent": {
      "additionalProperties": false,
      "properties": {
        "cost": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional cost (tokens or $) attributed to this step.",
          "title": "Cost"
        },
        "latency_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "parent_step_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "step_id this event derives from.",
          "title": "Parent Step Id"
        },
        "result": {
          "$ref": "#/$defs/AttributionResult"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "step_id": {
          "description": "0-indexed, strictly increasing. Canonical ordering key.",
          "minimum": 0,
          "title": "Step Id",
          "type": "integer"
        },
        "step_type": {
          "const": "attribution",
          "default": "attribution",
          "title": "Step Type",
          "type": "string"
        },
        "timestamp": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timestamp"
        }
      },
      "required": [
        "run_id",
        "step_id",
        "result"
      ],
      "title": "AttributionEvent",
      "type": "object"
    },
    "AttributionResult": {
      "additionalProperties": true,
      "description": "Judge/attribution output. Runs ONLY after a verifier result exists and never\noverrides it. Step fields use the TRACE attribution vocabulary.\n\nAuthoritative schema: TRA-10. Taxonomy for ``failure_category``: TRA-13.",
      "properties": {
        "causal_explanation": {
          "default": "",
          "title": "Causal Explanation",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "failure_category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Taxonomy bucket; owned by TRA-13.",
          "title": "Failure Category"
        },
        "first_suspicious_step": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Suspicious Step"
        },
        "first_unrecoverable_step": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The critical failure step: earliest point the run became unrecoverable.",
          "title": "First Unrecoverable Step"
        },
        "harmful_action_step": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Harmful Action Step"
        },
        "missed_recovery_step": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missed Recovery Step"
        },
        "regression_test_idea": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Regression Test Idea"
        },
        "suggested_guardrail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggested Guardrail"
        },
        "task_success": {
          "title": "Task Success",
          "type": "boolean"
        },
        "visible_failure_step": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where the failure first became user-visible.",
          "title": "Visible Failure Step"
        }
      },
      "required": [
        "task_success"
      ],
      "title": "AttributionResult",
      "type": "object"
    },
    "ErrorEvent": {
      "additionalProperties": false,
      "properties": {
        "cost": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional cost (tokens or $) attributed to this step.",
