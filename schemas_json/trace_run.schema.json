            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "parent_step_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "step_id this event derives from.",
          "title": "Parent Step Id"
        },
        "recoverable": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recoverable"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "step_id": {
          "description": "0-indexed, strictly increasing. Canonical ordering key.",
          "minimum": 0,
          "title": "Step Id",
          "type": "integer"
        },
        "step_type": {
          "const": "error",
          "default": "error",
          "title": "Step Type",
          "type": "string"
        },
        "timestamp": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timestamp"
        }
      },
      "required": [
        "run_id",
        "step_id",
        "error_type",
        "message"
      ],
      "title": "ErrorEvent",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": true,
      "description": "A renderable evidence unit. Design rule: the dashboard must render evidence\nwithout custom parsing, so keep it to flat, typed pointers + values.",
      "properties": {
        "kind": {
          "description": "e.g. 'step_ref' | 'state_path' | 'doc_span' | 'tool_arg' | 'text'.",
          "title": "Kind",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "pointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "JSON-path / document id / arg name the value came from.",
          "title": "Pointer"
        },
        "step_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Trajectory step this evidence points at, if any.",
          "title": "Step Id"
        },
        "value": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Evidence",
      "type": "object"
    },
