{
  "$defs": {
    "RunStatus": {
      "description": "Lifecycle of a run. NOTE: this is execution status, NOT task pass/fail \u2014\ncorrectness is decided by the verifier (see verification.py).",
      "enum": [
        "running",
        "completed",
        "error"
      ],
      "title": "RunStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Top-level run descriptor. One per run; carries the schema version.",
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "ended_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ended At"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "status": {
      "$ref": "#/$defs/RunStatus",
      "default": "running"
    },
    "step_count": {
      "default": 0,
      "title": "Step Count",
      "type": "integer"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "target_agent": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Human label for the agent under test.",
      "title": "Target Agent"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "termination_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Why the run ended (e.g. 'completed', 'max_steps', 'tool_error', 'exception').",
      "title": "Termination Reason"
    }
  },
  "required": [
    "run_id",
    "task_id",
    "created_at"
  ],
  "title": "RunMetadata",
  "type": "object"
}
