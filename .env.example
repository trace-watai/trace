# TRACE harness configuration — copy to .env and adjust.
# The CLI loads .env (without overriding real environment variables).
# Everything works with the defaults below and NO API keys: the fixture
# provider is the default and is what all tests and CI use.

# Which model adapter runs the agent: fixture | gemini | anthropic | openai
# Keep "fixture" unless you are actively prototyping a live model.
# Note: today's CLI commands are fixture-only (`run-fixture`), so this is
# read but only takes effect when a provider-agnostic `run` command lands.
TRACE_MODEL_PROVIDER=fixture

# Only required when TRACE_MODEL_PROVIDER=gemini (the adapter fails fast
# with instructions if it's missing). Free keys: https://aistudio.google.com/apikey
# Free-tier Gemini is for early prototyping; the team switches to sponsor
# credits if rate limits bite. Never commit a real key; never make tests
# depend on one.
GEMINI_API_KEY=

# Only required when a run uses the anthropic provider (the adapter fails fast
# with instructions if it's missing). Keys: https://console.anthropic.com/settings/keys
# A second vendor exists so a live result never depends on one credential.
# Never commit a real key; never make tests depend on one.
ANTHROPIC_API_KEY=

# Only required when a run uses the openai provider (the adapter fails fast with
# instructions if it's missing). Keys: https://platform.openai.com/api-keys
# OpenAI sends a seed, as Gemini does, and Anthropic's Messages API has none;
# the seeded sample plans in #217 need a provider that sends it. Never commit a
# real key; never make tests depend on one.
OPENAI_API_KEY=

# Where run artifact directories are written.
TRACE_RUNS_DIR=./runs

# Python logging level for the CLI: DEBUG | INFO | WARNING | ERROR
TRACE_LOG_LEVEL=INFO
