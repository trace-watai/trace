# Dashboard configuration — copy to .env.local and adjust.
# Next.js loads .env.local automatically for `next dev` / `next build`.

# Where the dashboard reads runs/{run_id}/ artifact directories from.
# Mirrors TRACE_RUNS_DIR in the harness's own .env.example (../../.env.example)
# so both can point at the same runs directory. Accepts an absolute path, or
# a path relative to this app's directory (apps/dashboard, where `next dev`
# runs from) — hence "../../runs" to reach the repo-root runs/ dir. Defaults
# to <repo root>/runs when unset.
TRACE_RUNS_DIR=../../runs
