# Run artifacts are regenerable outputs — never committed (keep the README).
runs/*
!runs/README.md

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Environments & secrets
.venv/
venv/
.env
.env.local
.env*.local

# OS / editor noise
.DS_Store
.idea/
.vscode/

# Agent worktrees
.worktrees/

# The advisory lock ArtifactStore takes beside index.json for every index write
# and for the bundle stage (#211). It is empty and means nothing once the
# process exits, and it appears wherever an index is written or rebuilt,
# including retained run folders.
.bundle.lock

# Generated by ArtifactStore when a retained evidence run is re-verified.
# Not part of the pinned evidence; the sha256 pins in fixtures/controls/library.json
# do not cover it, and a partial index dirties a tracked file (#192 review).
fixtures/controls/evidence/*/*/index.json
